---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { AUTHOR_PROFILE, SITE_TITLE, type AuthorLink } from '../consts';

interface Props {
	links?: readonly AuthorLink[];
}

const { links } = Astro.props;
---

<section class="author-profile">
	<Image
		class="author-avatar"
		src={avatar}
		alt=""
		width={96}
		height={96}
		aria-hidden="true"
	/>
	<div class="author-name">
		{SITE_TITLE}
		<span class="author-real-name">{AUTHOR_PROFILE.realName}</span>
	</div>
</section>
{
	AUTHOR_PROFILE.introduction.map((paragraph) => (
		<p class="author-bio">{paragraph}</p>
	))
}
{
	links && (
		<div class="author-social">
			{links.map((link) => (
				<a href={link.href} target="_blank" rel="noopener noreferrer">
					{link.label} ↗
				</a>
			))}
		</div>
	)
}
<style>
	.author-profile {
		display: flex;
		align-items: center;
		gap: var(--s-3);
	}
	.author-avatar {
		width: 48px;
		height: 48px;
		flex-shrink: 0;
		object-fit: cover;
	}
	.author-name {
		font-size: 16px;
		font-weight: var(--fw-medium);
	}
	.author-real-name {
		margin-left: var(--s-1);
		font-size: var(--fs-label);
		font-weight: var(--fw-light);
		color: var(--tertiary);
	}
	.author-bio {
		margin: var(--s-2) 0 0;
		max-width: 480px;
		font-size: 15px;
		line-height: 1.85;
		color: var(--secondary);
	}
	.author-social {
		display: flex;
		gap: 20px;
		margin-top: var(--s-3);
		font-size: var(--fs-label);
		letter-spacing: 0.06em;
		color: var(--secondary);
	}
</style>
