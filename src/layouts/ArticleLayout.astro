---
import type { CollectionEntry } from 'astro:content';
import AuthorBio from '../components/AuthorBio.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { ogImagePath } from '../features/og-image/model';
import type { NativeTimelineEntry } from '../features/timeline/model';

type Props = CollectionEntry<'articles'>['data'] & {
	slug: string;
	prev: NativeTimelineEntry | null;
	next: NativeTimelineEntry | null;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	slug,
	prev,
	next,
} = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			ogImagePath={ogImagePath(slug)}
		/>
	</head>
	<body>
		<Header />
		<main>
			<a href="/" class="back-link">← 一覧</a>
			<article class="blog-post-container">
				<header class="post-header">
					<h1 class="post-title">{title}</h1>
					<div class="post-meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<>
									<span class="post-meta-separator">·</span>
									更新: <FormattedDate date={updatedDate} />
								</>
							)
						}
					</div>
				</header>
				<div class="post-content">
					<slot />
				</div>
			</article>
			<AuthorBio />
			<nav class="prev-next" aria-label="記事ナビゲーション">
				{
					prev && (
						<a href={prev.href} class="prev-link">
							<span class="label">← 前の記事</span>
							<span class="title">{prev.title}</span>
						</a>
					)
				}
				{
					next && (
						<a href={next.href} class="next-link">
							<span class="label">次の記事 →</span>
							<span class="title">{next.title}</span>
						</a>
					)
				}
			</nav>
		</main>
		<Footer />
	</body>
</html>
<style>
	main {
		display: flex;
		flex-direction: column;
		gap: var(--s-7);
	}
	.back-link {
		font-size: var(--fs-caption);
		letter-spacing: 0.14em;
		color: var(--tertiary);
	}
	.post-header {
		display: flex;
		flex-direction: column;
		gap: var(--s-3);
	}
	.post-title {
		font-size: clamp(24px, 4vw, 30px);
		line-height: 1.45;
		font-weight: var(--fw-regular);
		letter-spacing: -0.01em;
	}
	.post-meta {
		font-size: 12px;
		letter-spacing: 0.1em;
		color: var(--secondary);
	}
	.post-meta-separator {
		margin: 0 4px;
	}
	.post-content {
		margin-top: var(--s-6);
		display: flex;
		flex-direction: column;
		gap: var(--s-4);
		font-size: 16px;
		line-height: 1.9;
	}
	.post-content :global(h2) {
		margin-top: var(--s-4);
	}
	.prev-next {
		display: flex;
		justify-content: space-between;
		gap: var(--s-3);
		padding-top: var(--s-5);
		border-top: 1px solid var(--outline);
	}
	.prev-link,
	.next-link {
		display: flex;
		flex-direction: column;
		gap: 4px;
		font-size: 13px;
	}
	.next-link {
		margin-left: auto;
		text-align: right;
	}
	.label {
		font-size: 11px;
		letter-spacing: 0.14em;
		color: var(--tertiary);
	}
</style>
