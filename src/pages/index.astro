---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import avatar from '../assets/avatar.png';
import AuthorBio from '../components/AuthorBio.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_LINKS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { HOME_OG_IMAGE_PATH } from '../features/og-image/model';
import { groupByYear, toTimelineEntry } from '../features/timeline/model';

const articles = await getCollection('articles');
const links = await getCollection('links');

const entries = [
	...articles.map((article) =>
		toTimelineEntry({
			type: 'article',
			slug: article.id,
			title: article.data.title,
			pubDate: article.data.pubDate,
		}),
	),
	...links.map((link) =>
		toTimelineEntry({
			type: 'link',
			url: link.data.url,
			title: link.data.title,
			pubDate: link.data.pubDate,
		}),
	),
];

const yearGroups = groupByYear(entries);
---

<html lang="ja">
	<head>
		<BaseHead
			title={SITE_TITLE}
			description={SITE_DESCRIPTION}
			ogImagePath={HOME_OG_IMAGE_PATH}
		/>
	</head>
	<body>
		<Header />
		<main>
			<AuthorBio links={AUTHOR_LINKS} />
			<div class="timeline">
				{yearGroups.map((group) => (
					<div class="year-group">
						<div class="year-label">{group.year}</div>
						{group.entries.map((entry) => (
							<a
								class="entry-row"
								href={entry.href}
								target={entry.kind === 'external' ? '_blank' : undefined}
								rel={
									entry.kind === 'external' ? 'noopener noreferrer' : undefined
								}
							>
								{entry.kind === 'native' ? (
									<Image
										class="entry-icon entry-favicon"
										src={avatar}
										alt=""
										width={32}
										height={32}
									/>
								) : (
									<img
										class="entry-icon entry-favicon"
										src={`https://www.google.com/s2/favicons?sz=32&domain=${entry.domain}`}
										alt=""
										width={16}
										height={16}
									/>
								)}
								<span class="entry-main">
									<span class="entry-title">{entry.title}</span>
									{entry.kind === 'external' && (
										<span class="entry-domain">{entry.domain} ↗</span>
									)}
								</span>
								<span class="entry-date">
									<FormattedDate date={entry.pubDate} />
								</span>
							</a>
						))}
					</div>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
<style>
	.timeline {
		margin-top: 112px;
		display: flex;
		flex-direction: column;
		gap: var(--s-6);
	}
	.year-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.year-label {
		font-size: 20px;
		font-weight: var(--fw-light);
		letter-spacing: -0.01em;
		margin-bottom: 12px;
	}
	.entry-row {
		display: grid;
		grid-template-columns: 20px minmax(0, 1fr) auto;
		align-items: center;
		gap: 14px;
		padding: 10px 12px;
		margin: 0 -12px;
		font-size: 15px;
		line-height: 1.6;
		background-image: none;
		transition: background var(--dur) var(--ease);
	}
	.entry-row:hover {
		background: var(--surface-container-low);
	}
	.entry-icon {
		width: 16px;
		height: 16px;
		display: block;
	}
	.entry-favicon {
		object-fit: cover;
	}
	.entry-main {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.entry-title {
		text-wrap: pretty;
	}
	.entry-domain {
		font-size: 11px;
		letter-spacing: 0.04em;
		color: var(--tertiary);
	}
	.entry-date {
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.04em;
		white-space: nowrap;
		color: var(--tertiary);
	}
</style>
