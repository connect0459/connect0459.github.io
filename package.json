{
	"name": "blog",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:md": "markdownlint-cli2 \"**/*.{md,mdx}\" \"#node_modules\" \"#dist\"",
		"lint:md:fix": "markdownlint-cli2 --fix \"**/*.{md,mdx}\" \"#node_modules\" \"#dist\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "astro check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"allowScripts": {
		"esbuild": true
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.2",
		"@astrojs/mdx": "8.0.2",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"astro": "7.3.5",
		"satori": "0.35.0",
		"satteri": "0.10.5",
		"sharp": "0.35.5"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@eslint/js": "10.0.1",
		"@vitest/coverage-v8": "5.0.3",
		"eslint": "10.12.0",
		"eslint-plugin-astro": "3.2.1",
		"markdownlint-cli2": "0.23.3",
		"prettier": "3.9.9",
		"prettier-plugin-astro": "1.1.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.3"
	}
}
